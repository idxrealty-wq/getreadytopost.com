        if (p.rating)   parts.push(`⭐ ${p.rating}`);
        return parts.join(' · ');
      })
      .join('\n');
    navigator.clipboard.writeText(`${key}:\n${lines}`);
    setCopiedKey(key);
    setTimeout(() => setCopiedKey(null), 2000);
