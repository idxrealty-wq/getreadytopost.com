      subscription: {
        planId: "elite-annual",
        status: "active",
        creditsPerCycle: 899,
        propertyPullPrice: 1.0,
        vaultAccess: true,
        workspaceAccess: true,
        billingCycle: "annual",
      },
    },
    "vault-only": {
      packageType: "vault-only",
      creditsToAdd: 0,
