        propertyPullPrice: 3,
        vaultAccess: true,
        workspaceAccess: true,
        billingCycle: "monthly",
      },
    },
    "semi-annual": {
      packageType: "semi-annual",
      creditsToAdd: 300,
      revenue: 495.0,
      subscription: {
        planId: "semi-annual",
        status: "active",
