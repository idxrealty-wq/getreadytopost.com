import { NextRequest, NextResponse } from "next/server";
import crypto from "crypto";
import { db } from "@/lib/firebase";
import { doc, updateDoc, getDoc, Timestamp } from "firebase/firestore";

const SQUARE_WEBHOOK_KEY = process.env.SQUARE_WEBHOOK_SIGNATURE_KEY || "";

// Verify Square webhook signature
function verifyWebhookSignature(
  body: string,
  signature: string,
  timestamp: string
): boolean {
  const payload = timestamp + body;
  const hash = crypto
    .createHmac("sha256", SQUARE_WEBHOOK_KEY)
    .update(payload)
    .digest("base64");
  return hash === signature;
}

// Map Square subscription plan to GRTP plan details
function getPlanDetails(squarePlanId: string) {
  const plans: Record<
    string,
    {
      planId: string;
      credits: number;
      propertyPullPrice: number;
      vaultAccess: boolean;
      workspaceAccess: boolean;
    }
  > = {
