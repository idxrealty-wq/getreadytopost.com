      submittedAt,
      approvedAt: null,
      lastVerifiedAt: null,
      expirationDate: null,
      reviewDeadline,
      verificationId: generateVerificationId(verificationType),
      publicSlug: generatePublicSlug(),
      fullName,
      companyName: companyName || null,
      phone,
      email,
      denialReason: null,
      notes:
        verificationType === 'buyer_seller'
