function verifySquareSignature(body: string, signature: string): boolean {
  if (!SQUARE_WEBHOOK_SIGNATURE_KEY) {
    console.warn("[Webhook] SQUARE_WEBHOOK_SIGNATURE_KEY not set, skipping verification");
    return true;
  }

  const hash = crypto
