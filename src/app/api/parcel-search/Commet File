export async function POST(request: NextRequest) {
  try {
    const body = await request.text();
    const signature = request.headers.get("x-square-hmac-sha256") || "";
    const timestamp = request.headers.get("x-square-timestamp") || "";

    // Verify webhook signature
    if (!verifyWebhookSignature(body, signature, timestamp)) {
      console.error("Invalid webhook signature");
      return NextResponse.json(
        { error: "Invalid signature" },
        { status: 403 }
      );
    }

    const event = JSON.parse(body);
    const eventType = event.type;
    const data = event.data?.object;

    console.log(`[Webhook] Event: ${eventType}`);

    // HANDLE: subscription.created
    if (eventType === "subscription.created") {
      const subscription = data;
      const customerId = subscription.customer_id;
      const squareSubscriptionId = subscription.id;
      const planDetails = getPlanDetails(subscription.plan_id);

      if (!planDetails) {
        console.warn(`Unknown plan: ${subscription.plan_id}`);
        return NextResponse.json({ success: true });
      }

      // Find user by Square customer ID
      const userQuery = await db
        .collection("users")
        .where("squareCustomerId", "==", customerId)
        .limit(1)
        .get();

      if (userQuery.empty) {
        console.warn(`User not found for customer: ${customerId}`);
        return NextResponse.json({ success: true });
      }

      const userId = userQuery.docs[0].id;
      const userRef = doc(db, "users", userId);

      // Calculate renewal date based on billing cycle
      const now = new Date();
      let renewalDate = new Date(now);
      if (planDetails.planId === "monthly") {
        renewalDate.setMonth(renewalDate.getMonth() + 1);
      } else if (planDetails.planId === "semi-annual") {
        renewalDate.setMonth(renewalDate.getMonth() + 6);
      } else if (
        planDetails.planId === "annual" ||
        planDetails.planId === "elite-annual"
      ) {
        renewalDate.setFullYear(renewalDate.getFullYear() + 1);
      } else if (planDetails.planId === "vault-only") {
        renewalDate.setFullYear(renewalDate.getFullYear() + 1);
      }

      await updateDoc(userRef, {
        subscription: {
          planId: planDetails.planId,
          status: "active",
          squareSubscriptionId,
          startDate: Timestamp.now(),
          renewalDate: Timestamp.fromDate(renewalDate),
          endDate: null,
          credits: planDetails.credits,
          creditsPerCycle: planDetails.credits,
          propertyPullPrice: planDetails.propertyPullPrice,
          vaultAccess: planDetails.vaultAccess,
          workspaceAccess: planDetails.workspaceAccess,
          lastPaymentDate: Timestamp.now(),
          nextPaymentAmount: subscription.price_money?.amount || 0,
          cancelledAt: null,
          cancellationReason: null,
        },
        squareCustomerId: customerId,
      });

      console.log(`[Webhook] Subscription created for user: ${userId}`);
      return NextResponse.json({ success: true });
    }

    // HANDLE: subscription.updated
    if (eventType === "subscription.updated") {
      const subscription = data;
      const customerId = subscription.customer_id;
      const squareSubscriptionId = subscription.id;

      const userQuery = await db
        .collection("users")
        .where("squareCustomerId", "==", customerId)
        .limit(1)
        .get();

      if (userQuery.empty) {
        return NextResponse.json({ success: true });
      }

      const userId = userQuery.docs[0].id;
      const userRef = doc(db, "users", userId);

      // Update subscription status based on Square status
      const squareStatus = subscription.status; // "ACTIVE", "PAUSED", "DELINQUENT", "CANCELED"
      let newStatus: "active" | "inactive" | "past_due" | "cancelled" =
        "inactive";
      if (squareStatus === "ACTIVE") newStatus = "active";
      if (squareStatus === "DELINQUENT") newStatus = "past_due";
      if (squareStatus === "CANCELED") newStatus = "cancelled";

      await updateDoc(userRef, {
        "subscription.status": newStatus,
        "subscription.lastPaymentDate": Timestamp.now(),
      });

      console.log(`[Webhook] Subscription updated for user: ${userId}`);
      return NextResponse.json({ success: true });
    }

    // HANDLE: subscription.deleted / cancelled
    if (eventType === "subscription.deleted") {
      const subscription = data;
      const customerId = subscription.customer_id;

      const userQuery = await db
        .collection("users")
        .where("squareCustomerId", "==", customerId)
        .limit(1)
        .get();

      if (userQuery.empty) {
        return NextResponse.json({ success: true });
      }

      const userId = userQuery.docs[0].id;
      const userRef = doc(db, "users", userId);

      await updateDoc(userRef, {
        "subscription.status": "cancelled",
        "subscription.endDate": Timestamp.now(),
        "subscription.cancelledAt": Timestamp.now(),
        "subscription.vaultAccess": false,
        "subscription.workspaceAccess": false,
      });

      console.log(`[Webhook] Subscription cancelled for user: ${userId}`);
      return NextResponse.json({ success: true });
    }

    // HANDLE: payment.created (for one-time purchases, legacy)
    if (eventType === "payment.created") {
      const payment = data;
      const customerId = payment.customer_id;

      if (!customerId) {
        console.warn("Payment without customer ID");
        return NextResponse.json({ success: true });
      }

      const userQuery = await db
        .collection("users")
        .where("squareCustomerId", "==", customerId)
        .limit(1)
        .get();

      if (userQuery.empty) {
        return NextResponse.json({ success: true });
      }

      const userId = userQuery.docs[0].id;
      const userRef = doc(db, "users", userId);

      // Add 1 credit for one-time purchase
      const userDoc = await getDoc(userRef);
      const currentCredits = userDoc.data()?.credits || 0;

      await updateDoc(userRef, {
        credits: currentCredits + 1,
      });

      console.log(`[Webhook] Credit added for user: ${userId}`);
      return NextResponse.json({ success: true });
    }

    return NextResponse.json({ success: true });
  } catch (error) {
    console.error("[Webhook Error]", error);
    return NextResponse.json(
      { error: "Webhook processing failed" },
      { status: 500 }
    );
  }
}
