import { db } from "@/lib/firebase";
import { doc, getDoc, Timestamp } from "firebase/firestore";

export interface UserEntitlements {
  vaultAccess: boolean;
  workspaceAccess: boolean;
  credits: number;
  propertyPullPrice: number;
  subscriptionStatus: "active" | "inactive" | "past_due" | "cancelled";
}

export async function getUserEntitlements(
  userId: string
): Promise<UserEntitlements> {
  try {
    const userRef = doc(db, "users", userId);
    const userDoc = await getDoc(userRef);

    if (!userDoc.exists()) {
      return {
        vaultAccess: false,
        workspaceAccess: false,
        credits: 0,
        propertyPullPrice: 0,
        subscriptionStatus: "inactive",
      };
    }

    const userData = userDoc.data();
    const subscription = userData?.subscription;

    // Check if subscription is expired
    let isSubscriptionActive = false;
    if (subscription && subscription.status === "active") {
      const renewalDate = subscription.renewalDate?.toDate?.() || new Date();
      isSubscriptionActive = new Date() < renewalDate;
    }

    return {
      vaultAccess: subscription?.vaultAccess && isSubscriptionActive,
      workspaceAccess: subscription?.workspaceAccess && isSubscriptionActive,
      credits: subscription?.credits || userData?.credits || 0,
      propertyPullPrice: subscription?.propertyPullPrice || 3.0,
      subscriptionStatus: isSubscriptionActive
        ? subscription?.status || "inactive"
        : "inactive",
    };
  } catch (error) {
    console.error("Error getting entitlements:", error);
    return {
      vaultAccess: false,
      workspaceAccess: false,
      credits: 0,
      propertyPullPrice: 0,
      subscriptionStatus: "inactive",
    };
  }
}

export async function checkVaultAccess(userId: string): Promise<boolean> {
  const entitlements = await getUserEntitlements(userId);
  return entitlements.vaultAccess;
}

export async function checkWorkspaceAccess(userId: string): Promise<boolean> {
  const entitlements = await getUserEntitlements(userId);
  return entitlements.workspaceAccess;
}

export async function deductCredit(
  userId: string,
  amount: number = 1
): Promise<boolean> {
  try {
    const entitlements = await getUserEntitlements(userId);

    if (entitlements.credits < amount) {
      return false; // Insufficient credits
    }

    const userRef = doc(db, "users", userId);
    await updateDoc(userRef, {
      "subscription.credits": entitlements.credits - amount,
    });

    return true;
  } catch (error) {
    console.error("Error deducting credit:", error);
    return false;
  }
}
